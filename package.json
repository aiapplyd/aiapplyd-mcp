{
  "name": "getmattered-mcp",
  "version": "1.10.0",
  "description": "Auto-Apply That Ends on an Interview. GetMattered MCP server: your matched jobs, applications submitted on the employer's own hiring system across 30+ hiring systems (sent automatically or held for your approval), a review queue, employer-receipt tracking, a resume rewritten for each role, cover letters and interview preparation.",
  "type": "module",
  "bin": {
    "getmattered-mcp": "dist/index.js",
    "aiapplyd-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json",
    "CHANGELOG.md",
    "plugins"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "ats",
    "auto-apply",
    "career",
    "chatgpt",
    "claude",
    "cli",
    "cursor",
    "getmattered",
    "interview-prep",
    "job-application",
    "job-search",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "resume"
  ],
  "author": "GetMattered <ava@getmattered.com>",
  "license": "MIT",
  "homepage": "https://getmattered.com/mcps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmattered/getmattered-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/getmattered/getmattered-mcp/issues",
    "email": "support@getmattered.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "mcpName": "com.getmattered/getmattered"
}
