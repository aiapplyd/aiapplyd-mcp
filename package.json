{
  "name": "aiapplyd-mcp",
  "version": "1.3.0",
  "description": "AI Applyd MCP server - ATS resume scoring, per-role resume rewriting, cover letters, interview preparation, job matching, and applications submitted on the employer's own hiring system across twelve major ATS platforms.",
  "type": "module",
  "bin": {
    "aiapplyd-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ats",
    "resume",
    "job-search",
    "job-application",
    "interview-prep",
    "career",
    "claude",
    "cursor",
    "chatgpt"
  ],
  "author": "AI Applyd",
  "license": "MIT",
  "homepage": "https://aiapplyd.com/mcps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whateverneveranywhere/aiapplyd-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/whateverneveranywhere/aiapplyd-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
