{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getmattered/getmattered",
  "title": "GetMattered",
  "description": "Auto-Apply That Ends on an Interview. Job matches, per-role resumes, apply, approve, track receipts.",
  "version": "1.10.1",
  "websiteUrl": "https://getmattered.com/mcps",
  "icons": [
    {
      "src": "https://getmattered.com/static/images/logos/icon-logo-dark-square.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/getmattered/getmattered-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.getmattered.com/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool": "mcp-publisher",
      "version": "1.0.0"
    }
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "getmattered-mcp",
      "version": "1.10.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GETMATTERED_TOKEN",
          "description": "Optional bearer token. Leave unset and run `npx getmattered-mcp login` once instead. The variable name used before the rename is still read when this one is unset.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
